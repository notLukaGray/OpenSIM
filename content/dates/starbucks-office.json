      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "special"
      },
      "callbacks": [
        {
          "if": "present",
          "text": [
            "You chose the slow version once. I keep receipts on kindness too."
          ]
        },
        {
          "if": "named-the-room",
          "text": [
            "Harsh. Accurate. See you at 8:47 regardless."
          ]
        },
        {
          "if": "priced-intimacy",
