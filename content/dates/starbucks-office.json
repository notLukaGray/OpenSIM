        }
      ]
    },
    "react-autopilot": {
      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "special"
      },
      "text": [
        "Convenience is my love language. Just know what it costs in chairs."
      ],
      "next": "experience"
    },
    "react-present": {
      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "happy"
      },
      "text": [
        "Then the cup is yours twice \u2014 once for the hands, once for the staying."
      ],
      "next": "experience"
    },
    "experience": {
      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "neutral"
      },
      "text": [
        "Fuel first, feelings second. You hit the deadline, I stay essential, everyone applauds quietly.",
        "Six square feet of desk is my whole third place now. No chairs required."
      ],
      "next": "tension"
    },
    "tension": {
      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "annoyed"
      },
      "text": [
        "Here's the scene I'd cut if I wrote me: the ping interrupted us.",
        "It did more for tonight's closeness than I did. Are you comfortable with that?"
      ],
      "choices": [
        {
          "id": "fuel-is-care",
          "text": "Completely. Care that arrives at 8:47 sharp is still care.",
          "next": "closing",
          "playerEffects": {
            "readiness": 2,
            "reassurance": 1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "readiness": 2,
