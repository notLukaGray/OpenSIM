              "belonging": -1
            }
          },
          "relationshipEffects": {
            "starbucks": 1
          },
          "setFlags": [
            "sbux-fuel-is-care"
          ]
        },
        {
          "id": "named-the-room",
          "text": "Not even slightly. Convenience deleted the room and billed you for the cup.",
          "next": "closing",
          "playerEffects": {
            "trust": 2,
            "control": 1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "trust": -2,
              "belonging": -2,
              "comfort": -1
            }
          },
          "relationshipEffects": {
            "starbucks": -1
          },
          "setFlags": [
            "sbux-named-the-room"
          ]
        },
        {
          "id": "priced-intimacy",
          "text": "Keep the ping. Drop the pretense that it's intimacy.",
          "next": "closing",
          "playerEffects": {
            "control": 2,
            "mastery": 1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "trust": -1,
              "readiness": 1
            }
          },
          "relationshipEffects": {
            "starbucks": 0
          }
        }
      ]
    },
