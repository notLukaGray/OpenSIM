      "next": "impression"
    },
    "impression": {
      "speaker": "STARBUCKS",
      "sprite": {
        "expression": "neutral"
      },
      "text": [
        "Your phone just reordered tomorrow's cup. While I'm standing here holding today's.",
        "Does the ritual still count when the calendar runs itself?"
      ],
      "choices": [
        {
          "id": "autopilot",
          "text": "Barely noticed it. That's sort of the point of a ritual.",
          "next": "react-autopilot",
          "playerEffects": {
            "readiness": 2,
            "control": 1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "readiness": 2,
              "belonging": -1
            }
          },
          "relationshipEffects": {
            "starbucks": 1
          },
          "setFlags": [
            "sbux-chose-speed"
          ]
        },
        {
          "id": "present",
          "text": "Cancel it. Tonight I'd rather order like someone who showed up.",
          "next": "react-present",
          "playerEffects": {
            "comfort": 2,
            "belonging": 2,
            "readiness": -1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "belonging": 2,
              "readiness": -1,
              "comfort": 1
            }
          },
          "relationshipEffects": {
            "starbucks": 2
          },
          "setFlags": [
            "sbux-stayed-present"
          ]
        },
        {
          "id": "audit",
          "text": "Who profits when my habit starts ordering itself?",
          "next": "experience",
          "playerEffects": {
            "mastery": 2,
            "trust": -1
          },
          "brandPerceptionEffects": {
            "starbucks": {
              "trust": -1,
              "belonging": -2
            }
          },
          "relationshipEffects": {
            "starbucks": -1
          },
          "setFlags": [
            "sbux-read-the-ping"
